{
  "version": 2,
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://grovix-app.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://grovix-app.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

